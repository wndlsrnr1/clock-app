{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "app.clock.personal-time-manager",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "nativeAllowList": [
    "app.*",
    "events.*",
    "window.*",
    "os.showNotification",
    "os.setTray",
    "os.getEnvs",
    "os.open",
    "os.showOpenDialog",
    "os.showSaveDialog",
    "os.execCommand",
    "server.getMounts",
    "server.mount",
    "filesystem.createDirectory",
    "filesystem.getPathParts",
    "filesystem.getStats",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.writeBinaryFile",
    "storage.*"
  ],
  "modes": {
    "window": {
      "title": "Clock Rhythm",
      "width": 920,
      "height": 680,
      "minWidth": 720,
      "minHeight": 560,
      "icon": "/dist/icon.png",
      "exitProcessOnClose": false,
      "injectGlobals": true,
      "injectClientLibrary": false
    }
  },
  "cli": {
    "binaryName": "clock-rhythm",
    "resourcesPath": "/dist/",
    "clientLibrary": "/dist/neutralino.js",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:14557",
      "projectPath": "/",
      "initCommand": "npm install",
      "devCommand": "npm run dev:vite -- --host localhost --port 14557 --strictPort",
      "buildCommand": "npm run build:vite"
    },
    "binaryVersion": "6.7.0",
    "clientVersion": "6.7.0"
  }
}
